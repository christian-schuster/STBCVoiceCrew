<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Das Spiel läuft auf Unity 5.4 / Mono (.NET-3.5-Profil). Referenziert werden die DLLs direkt
    aus der Spielinstallation. Pfad bei Bedarf überschreiben:
      dotnet build -p:GameDir="D:\Pfad\zu\Star Trek Bridge Crew"
  -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>StbcAiCrew</AssemblyName>
    <RootNamespace>StbcAiCrew</RootNamespace>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">G:\SteamLibrary\steamapps\common\Star Trek Bridge Crew</GameDir>
    <ManagedDir>$(GameDir)\stbc_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <!-- Nach dem Build direkt ins Spiel kopieren (abschalten mit -p:DeployToGame=false) -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GameDir)\BepInEx')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\StbcAiCrew" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\StbcAiCrew" />
    <Message Importance="high" Text="StbcAiCrew -> $(GameDir)\BepInEx\plugins\StbcAiCrew" />
  </Target>

</Project>
